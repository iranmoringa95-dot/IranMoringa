<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/buttonBackSettings" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:text="→" android:textColor="@color/primary" android:textSize="22sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="تنظیمات" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اتصال به سرور" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <EditText android:id="@+id/inputApiUrl" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:hint="https://moringano.ir/api/v1" android:inputType="textUri" android:singleLine="true" android:textDirection="ltr" />
            <Button android:id="@+id/buttonSaveApiUrl" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_primary_button" android:text="ذخیره و تست اتصال" android:textColor="@android:color/white" />
            <ProgressBar android:id="@+id/progressSettings" style="?android:attr/progressBarStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="10dp" android:visibility="gone" />
            <TextView android:id="@+id/textSettingsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اعلان سفارش جدید" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <Switch android:id="@+id/switchNotifications" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="5dp" android:text="اتصال زنده و نمایش اعلان native" android:textColor="@color/text_primary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="برای اتصال لحظه‌ای، اندروید یک اعلان کم‌اهمیت دائمی نمایش می‌دهد. با رسیدن سفارش جدید، اعلان جداگانه با صدا و لرزش صادر می‌شود." android:textColor="@color/text_secondary" android:textSize="13sp" />
        </LinearLayout>

        <Button android:id="@+id/buttonLogout" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:background="@drawable/bg_outline_button" android:text="خروج امن از حساب" android:textColor="@color/danger" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="نسخه ۱.۰.۰ — Java Native" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
