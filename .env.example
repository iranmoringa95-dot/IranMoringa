# General Application Settings
APP_NAME="MoringaLab Commerce"
APP_ENV=development
APP_PORT=8080
WEB_PORT=3000
DOMAIN=localhost
PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=moringalab
DB_PASSWORD=moringalab_dev_pass
DB_NAME=moringalab_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

# Redis Configuration (Optional Cache/Rate-limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & Security Credentials (DEVELOPMENT PLACEHOLDERS ONLY)
SESSION_SECRET=dev_session_secret_change_in_production_min_32bytes
CSRF_SECRET=dev_csrf_secret_change_in_production_min_32bytes
ADMIN_INITIAL_EMAIL=admin@moringalab.local
ADMIN_INITIAL_PASSWORD=AdminSecurePass123!

# Storage Configuration (MinIO / Local S3 compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_admin_secret
STORAGE_BUCKET=moringalab-media
STORAGE_USE_SSL=false

# Development Provider Mocks / Production Providers
SMS_PROVIDER=webonesms # Options: fake, webonesms
EMAIL_PROVIDER=mailpit
PAYMENT_GATEWAY=fake

# WebOneSMS Integration (webonesms.ir / rest.payamakapi.ir)
WEBONESMS_USERNAME=your_webonesms_username
WEBONESMS_PASSWORD=your_webonesms_password
WEBONESMS_API_KEY=your_webonesms_api_key_here
WEBONESMS_SENDER=1000xxxx
WEBONESMS_BASE_URL=https://rest.payamakapi.ir/api/v1
WEBONESMS_OTP_TEMPLATE_ID=12345

# Mailpit (Dev SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
